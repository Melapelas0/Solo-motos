# BACKEND - Variables de Entorno REQUERIDAS para Producción
# Copia este archivo a .env y configura los valores

# ⚠️ CRÍTICO: Este valor debe ser una cadena LARGA y ALEATORIA (mínimo 32 caracteres)
# Genera una usando: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=<GENERA_UNA_CADENA_ALEATORIA_DE_32_CARACTERES>

# ⚠️ CRÍTICO: Contraseña de administrador - Mínimo 12 caracteres, compleja
# Usa caracteres mayúsculas, minúsculas, números y símbolos
ADMIN_PASSWORD=<CONTRASEÑA_FUERTE_AQUI>

# Usuario administrador (puede ser cualquier nombre)
VITE_ADMIN_USER=admin

# ===== BASE DE DATOS =====
# Ejemplo con PostgreSQL (recomendado para producción)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/solomotos

# ===== FRONTEND =====
# URL del frontend en producción (para CORS)
VITE_API_URL=https://api.tudominio.com

# URL completa del frontend (para validar origen)
FRONTEND_URL=https://tudominio.com

# ===== SEGURIDAD =====
# Hosts permitidos para evitar Host Header Injection
ALLOWED_HOSTS=tudominio.com,www.tudominio.com,api.tudominio.com
